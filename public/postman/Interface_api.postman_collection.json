{
    "info": {
        "name": "Interface API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Collection for testing the DB_Middle SQL Server API. Import the matching environment file to manage baseUrl and userID separately."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5050"
        },
        {
            "key": "userID",
            "value": "U001"
        }
